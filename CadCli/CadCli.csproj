<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CadCli</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- DwgSharpKit（独立 NuGet 包，ACadSharp 随包带入）：
         发布前用本地源 ../nupkgs；发布后用 nuget.org 的正式版本 -->
    <PackageReference Include="DwgSharpKit" Version="0.1.0" />
  </ItemGroup>
</Project>
